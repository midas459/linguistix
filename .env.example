# These values document Base44 server secrets; the app reads them with base44:runtime.
# Configure them with `base44 secrets set NAME=VALUE` or in the Base44 dashboard.
# Never commit actual API keys, put them in VITE_* variables, or store them in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
