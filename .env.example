# Public Supabase project configuration. These values identify the project and
# the publishable key is intended for browser use; RLS must protect all tables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only AI provider credentials. Never use NEXT_PUBLIC_ for secrets.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# Optional server-only Supabase service role key. Leave unset unless a reviewed
# server/Edge Function genuinely needs privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=
