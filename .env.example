# This documents Base44 server secrets; the app reads them with base44:runtime.
# Configure the secret with `base44 secrets set GEMINI_API_KEY` or in the Base44 dashboard.
# Never commit actual API keys, put them in VITE_* variables, or store them in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
