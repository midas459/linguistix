# Copy this file to .env.local and fill in values from your Supabase project settings.
# The publishable key is safe for browser use when Row Level Security is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only AI keys. Never add NEXT_PUBLIC_ to these names.
# Gemini is tried first; Groq is used as a fallback when configured.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=YOUR_GROQ_API_KEY
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI-compatible fallback (also supports custom compatible gateways).
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Never commit .env.local or put provider keys in browser code.
