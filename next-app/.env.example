# Public Supabase project configuration (safe to expose only with correct RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Google Gemini tutor credentials. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional model override; default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Never commit .env.local. In Cloudflare, configure these as runtime/build secrets
# using the Cloudflare dashboard or Wrangler secret management.

# Canonical public app origin; set to the deployed HTTPS hostname (never localhost).
NEXT_PUBLIC_SITE_URL=https://your-public-host.example
