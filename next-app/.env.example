# Copy this file to .env.local and fill in values from the Supabase project settings.
# The publishable key is safe for browser use when Row Level Security is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets must never use the NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional AI tutor provider configuration (server-side only).
# OPENAI_API_KEY=YOUR_AI_PROVIDER_API_KEY
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
